{
  "name": "api",
  "version": "1.0.50",
  "main": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test test/hyperliquid.test.ts",
    "test:e2e": "RUN_E2E=1 bun test test/integration.e2e.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --target bun --outfile server ./src/index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.3.0",
    "@elysiajs/static": "^1.3.0",
    "@nktkas/hyperliquid": "^0.23.1",
    "@repo/db": "workspace:*",
    "@types/jsonwebtoken": "^9.0.9",
    "arctic": "^3.6.1",
    "elysia": "latest",
    "elysia-oauth2": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "siwe": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.31.4"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.3.2",
    "@types/dockerode": "^3.3.39",
    "bun-types": "latest"
  },
  "module": "src/index.js"
}
