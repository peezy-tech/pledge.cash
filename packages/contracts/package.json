{
  "name": "@pledge.cash/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "forge build",
    "check:boardroom-manifests": "bun script/check-boardroom-diamond-manifests.ts",
    "deploy:network": "script/deploy-network.sh",
    "deploy:sepolia": "script/deploy-network.sh 11155111 --broadcast",
    "deploy:base-sepolia": "script/deploy-network.sh 84532 --broadcast",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "preflight:network": "script/verify-network-profile-live.sh",
    "simulate:network": "script/deploy-network.sh",
    "simulate:sepolia": "script/deploy-network.sh 11155111",
    "simulate:base-sepolia": "script/deploy-network.sh 84532",
    "test:sepolia-fork:deployment": "script/sepolia-fork/deploy.sh",
    "test:base-sepolia-fork:deployment": "script/network-fork/deploy.sh 84532",
    "test:testnet-forks:deployment": "script/network-fork/deploy.sh 11155111 && script/network-fork/deploy.sh 84532",
    "test:network-profiles": "bun test script/network-profiles.test.ts",
    "test": "forge test -vvv",
    "validate:networks": "bun script/network-profiles.ts",
    "verify:network-artifact": "script/verify-network-artifact.sh",
    "verify:testnet-artifacts": "script/verify-network-artifact.sh 11155111 && script/verify-network-artifact.sh 84532"
  }
}
