{
  "name": "@pledge.cash/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "forge build",
    "check:boardroom-manifests": "bun script/check-boardroom-diamond-manifests.ts",
    "deploy:monad-testnet": "BROADCAST=1 script/monad-testnet/deploy.sh && bun --cwd ../sdk generate",
    "deploy:testnets": "bun run deploy:monad-testnet",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "scenario:local-seed:dry-run": "forge script script/SeedLocal.s.sol:SeedLocal --rpc-url ${LOCAL_RPC_URL:-local} -vvv",
    "scenario:local-seed:local": "forge script script/SeedLocal.s.sol:SeedLocal --rpc-url ${LOCAL_RPC_URL:-local} --broadcast --slow -vvv",
    "scenario:boardroom:dry-run": "forge script script/BoardroomScenario.s.sol:BoardroomScenario -vvv",
    "scenario:boardroom:local": "script/run-boardroom-local.sh",
    "scenario:project-token:dry-run": "forge script script/ProjectTokenLaunchScenario.s.sol:ProjectTokenLaunchScenario -vvv",
    "scenario:project-token:local": "forge script script/ProjectTokenLaunchScenario.s.sol:ProjectTokenLaunchScenario --rpc-url local --broadcast -vvv",
    "simulate:monad-testnet": "script/monad-testnet/deploy.sh",
    "simulate:testnets": "bun run simulate:monad-testnet",
    "test:sepolia-fork:deployment": "script/sepolia-fork/deploy.sh",
    "test": "forge test -vvv",
    "verify:monad-testnet-artifact": "script/monad-testnet/verify-artifact.sh",
    "verify:testnet-artifacts": "bun run verify:monad-testnet-artifact"
  }
}
