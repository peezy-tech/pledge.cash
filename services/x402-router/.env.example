# Dedicated Postgres database. The runtime uses its own Drizzle migration
# metadata schema even if this database also hosts unrelated application tables.
DATABASE_URL=postgres://x402_router:x402_router@localhost:5432/x402_router

# HTTP and signed-intent deployment identity.
X402_ROUTER_PORT=8788
X402_ROUTER_PUBLIC_ORIGIN=http://127.0.0.1:8788
X402_ROUTER_WEB_ORIGIN=http://localhost:5173
X402_ROUTER_APPLICATION=api.pledge.cash/x402-router/v1/execute
X402_ROUTER_GATEWAY_ADDRESS=0x0000000000000000000000000000000000000000
# 32 random bytes encoded as 64 hexadecimal characters. This key encrypts
# signed payment envelopes and signed transaction journals at rest.
X402_ROUTER_JOURNAL_ENCRYPTION_KEY=

# HyperCore payment/refund rail. V1 deliberately supports testnet only.
HYPERLIQUID_NETWORK=hyperliquid:testnet
HYPERLIQUID_PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
HYPERLIQUID_REFUND_PRIVATE_KEY=
X402_ROUTER_PAYMENT_ASSET=USDC:0xeb62eee3685fc4c43992febcd9e75443
X402_ROUTER_PAYMENT_DECIMALS=8

# HyperEVM fulfillment rail. The gateway address must equal the account derived
# from this private key so the signed domain and actual executor cannot drift.
HYPEREVM_CHAIN_ID=998
HYPEREVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
X402_ROUTER_HYPEREVM_USDC_ADDRESS=
HYPEREVM_EXECUTOR_PRIVATE_KEY=
HYPEREVM_CONFIRMATIONS=1
HYPEREVM_RECEIPT_TIMEOUT_MS=120000
HYPEREVM_MIN_GAS_BALANCE_WEI=100000000000000000

# Bounded quote, execution, and refund policy.
X402_ROUTER_QUOTE_TTL_SECONDS=300
X402_ROUTER_MAX_ORDER_ATOMIC=100000000
# Explicit fee policy. 0 disables the service fee; there is no hidden default.
X402_ROUTER_SERVICE_FEE_BPS=0
X402_ROUTER_MIN_REFUND_RESERVE_ATOMIC=100000000
X402_ROUTER_MAX_GAS_COST_WEI=2500000000000000
X402_ROUTER_MAX_SLIPPAGE_BPS=100
X402_ROUTER_OPERATION_LEASE_MS=60000
