# Postgres connection string used by Drizzle and the identity runtime.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel

# HTTP API.
SENTINEL_PORT=8787
SENTINEL_WEB_ORIGIN=http://localhost:5173
# Comma-separated socket peers whose client-address headers Sentinel may trust.
# Required for HTTPS shared Identity deployments; use the exact edge proxy IPs.
# SENTINEL_TRUSTED_PROXY_IPS=127.0.0.1,::1

# PledgeCash product sessions. Generate a unique 32+ character secret.
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-secret
BETTER_AUTH_URL=http://localhost:8787

# Shared peezy.tech Identity. Configure all four values together to make Identity
# canonical for social and wallet credentials. The app secret authenticates
# confidential Identity API calls; the distinct OIDC secret authenticates the
# authorization-code exchange.
# PEEZY_IDENTITY_URL=http://localhost:8790
# PEEZY_IDENTITY_CLIENT_ID=pledge-cash
# PEEZY_IDENTITY_APP_CLIENT_SECRET=
# PEEZY_IDENTITY_OIDC_CLIENT_SECRET=

# Legacy standalone mode only. When PEEZY_IDENTITY_* is unset, these optional
# id/secret pairs keep Sentinel-owned social login available. In shared-identity
# mode, configure social providers on Identity instead.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
