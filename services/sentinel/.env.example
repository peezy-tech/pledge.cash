# Postgres connection string used by Drizzle and the Sentinel runtime.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel

# HTTP API.
SENTINEL_PORT=8787
SENTINEL_WEB_ORIGIN=http://localhost:5173
# Comma-separated socket peers whose client-address headers Sentinel may trust.
# Required for HTTPS shared Identity deployments; use the exact edge proxy IPs.
# SENTINEL_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Chains to monitor.
SENTINEL_CHAIN_IDS=10143
SENTINEL_RPC_URL_10143=https://testnet-rpc.monad.xyz
# SENTINEL_RPC_URL_31337=http://127.0.0.1:8545
# SENTINEL_CONFIRMATIONS_10143=5
# SENTINEL_CONFIRMATIONS_31337=0
SENTINEL_POLL_INTERVAL_MS=12000
SENTINEL_MAX_BLOCK_RANGE=1000
# SENTINEL_EXPLORER_URL_10143=
# SENTINEL_EXPLORER_URL_31337=

# PledgeCash product sessions. Generate a unique 32+ character secret.
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-secret
BETTER_AUTH_URL=http://localhost:8787

# Shared peezy.tech Identity. Configure all four values together to make Identity
# canonical for social and wallet credentials. The app secret authenticates
# confidential Identity API calls; the distinct OIDC secret authenticates the
# authorization-code exchange.
# PEEZY_IDENTITY_URL=http://localhost:8790
# PEEZY_IDENTITY_CLIENT_ID=pledge-cash
# PEEZY_IDENTITY_APP_CLIENT_SECRET=
# PEEZY_IDENTITY_OIDC_CLIENT_SECRET=

# Legacy standalone mode only. When PEEZY_IDENTITY_* is unset, these optional
# id/secret pairs keep the previous Sentinel-owned social-login implementation.
# In shared-identity mode, configure social providers on Identity instead.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Agent harness. Harness auth belongs to the host environment, not Sentinel config.
SENTINEL_HARNESS=claude
# SENTINEL_HARNESS_CMD=
SENTINEL_HARNESS_MODEL=claude-opus-4-8
# SENTINEL_HARNESS_WORKDIR=
SENTINEL_HARNESS_TIMEOUT_MS=300000
SENTINEL_HARNESS_DAILY_LIMIT=50
# Comma-separated boardrooms that may use the harness even without subscribers.
SENTINEL_HARNESS_BOARDROOM_ALLOWLIST=
SENTINEL_REMINDER_HOURS_BEFORE_ETA=24

# Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Twitter notifications.
SENTINEL_TWITTER_ENABLED=0
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
