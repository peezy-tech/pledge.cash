# HyperEVM testnet deployment.
HYPEREVM_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# Use a deployment key with only the funds needed for the deployment.
# HYPEREVM_TESTNET_PRIVATE_KEY=

# Native creation fee charged by TokenGrantFactory.createGrant.
# 0.1 HYPE = 100000000000000000 wei.
TOKEN_GRANT_CREATION_FEE_WEI=100000000000000000

# Canonical WHYPE address used by Boardrooms and native-token AMM routes.
WRAPPED_NATIVE_ADDRESS=

# Deterministic deployment path. The default CREATE2 factory is Foundry's
# Arachnid deterministic-deployment proxy. Set PLEDGE_CASH_DETERMINISTIC_DEPLOYER
# only when reusing an already deployed pledge.cash deterministic deployer owned by
# the current deployment key.
CREATE2_FACTORY_ADDRESS=0x4e59b44847b379578588920cA78FbF26c0B4956C
# PLEDGE_CASH_DETERMINISTIC_DEPLOYER=

# Dry-run by default. Set BROADCAST=1 only when ready to send transactions.
BROADCAST=0

# Optional gas overrides for HyperEVM testnet.
# HYPEREVM_GAS_PRICE_WEI=
GAS_ESTIMATE_MULTIPLIER=200
