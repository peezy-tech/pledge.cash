# Shared deterministic deployment owner.
# Use the same deployment key address on every chain that should share root
# contract addresses.
PLEDGE_CASH_DETERMINISTIC_DEPLOYER_OWNER=

# HyperEVM testnet deployment.
HYPEREVM_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# HYPEREVM_TESTNET_PRIVATE_KEY=
# HYPEREVM_WRAPPED_NATIVE_ADDRESS=

# Monad testnet deployment.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_TESTNET_PRIVATE_KEY=
MONAD_TESTNET_WRAPPED_NATIVE_ADDRESS=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541

# Native creation fee charged by TokenGrantFactory.createGrant.
# 0.1 native token = 100000000000000000 wei.
TOKEN_GRANT_CREATION_FEE_WEI=100000000000000000

# Deterministic deployment path. The default CREATE2 factory is Foundry's
# Arachnid deterministic-deployment proxy. Set PLEDGE_CASH_DETERMINISTIC_DEPLOYER
# only when reusing an already deployed pledge.cash deterministic deployer owned by
# the current deployment key.
CREATE2_FACTORY_ADDRESS=0x4e59b44847b379578588920cA78FbF26c0B4956C
# PLEDGE_CASH_DETERMINISTIC_DEPLOYER=

# Dry-run by default. Set BROADCAST=1 only when ready to send transactions.
BROADCAST=0

# Optional gas overrides.
# HYPEREVM_GAS_PRICE_WEI=
HYPEREVM_GAS_ESTIMATE_MULTIPLIER=100
MONAD_GAS_ESTIMATE_MULTIPLIER=100

# Optional public WalletConnect Cloud project ID used by the web app's
# SimpleKit wallet modal. Leave unset to show injected and Coinbase wallets
# only.
# VITE_PLEDGE_CASH_WALLETCONNECT_PROJECT_ID=
