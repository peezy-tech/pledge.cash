# Shared deterministic deployment owner.
# Use the same deployment key address on every chain that should share root
# contract addresses.
PLEDGE_CASH_DEPLOYER_PRIVATE_KEY=
PLEDGE_CASH_DETERMINISTIC_DEPLOYER_OWNER=

# Explicit root authority roles. These may be the same address for local
# development, but production/testnet operations should use a durable owner
# (such as a Safe) and treasury rather than a wind-downable project Boardroom.
PLEDGE_CASH_PROTOCOL_OWNER=
PLEDGE_CASH_PROTOCOL_TREASURY=

# Optional operator-owned RPC overrides. Leave these blank to use the
# manifest's public fallbacks for simulation. Any broadcast requires an
# explicitly configured endpoint here or in PLEDGE_CASH_RPC_URL.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
ROBINHOOD_CHAIN_RPC_URL=
PLEDGE_CASH_RPC_URL=

# Optional exact block pins for isolated public-chain fork proofs.
SEPOLIA_FORK_BLOCK=
BASE_SEPOLIA_FORK_BLOCK=
NETWORK_FORK_BLOCK=
NETWORK_FORK_PORT=8551

# Native creation fee charged by TokenGrantFactory.createGrant.
# 0.1 native token = 100000000000000000 wei.
TOKEN_GRANT_CREATION_FEE_WEI=100000000000000000

# Set PLEDGE_CASH_DETERMINISTIC_DEPLOYER only when reusing an already deployed
# pledge.cash deterministic deployer owned by the current deployment key.
# PLEDGE_CASH_DETERMINISTIC_DEPLOYER=

# Dry-run is the default. Broadcast authorization is not configurable here:
# it requires command-line --broadcast <chain-id:exact-source-commit>, and a
# mainnet invocation additionally requires --allow-mainnet.

# Optional gas overrides.
GAS_ESTIMATE_MULTIPLIER=120
CONFIRMATION_TIMEOUT_SECONDS=1800
