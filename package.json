{
  "name": "drama.haus",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "docker:build": "docker build -f apps/api/Dockerfile -t hypstudio  .",
    "docker:tag": "docker tag hypstudio itspeezy/hypstudio:latest",
    "docker:push": "docker push itspeezy/hypstudio:latest"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.1.42",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/"
  ],
  "dependencies": {
    "@types/three": "^0.176.0",
    "three": "^0.176.0"
  }
}
