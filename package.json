{
  "name": "pledge.cash",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20"
  },
  "workspaces": {
    "packages": [
      "packages/contracts",
      "packages/sdk",
      "apps/*"
    ],
    "catalog": {
      "@types/node": "^25.6.1",
      "typescript": "5.9.3",
      "viem": "^2.48.8"
    }
  },
  "scripts": {
    "build": "bun --cwd packages/contracts build && bun --cwd packages/sdk build && bun --cwd apps/web build",
    "deploy:hyperevm-testnet": "bun --cwd packages/contracts deploy:hyperevm-testnet",
    "format": "bun --cwd packages/contracts format",
    "format:check": "bun --cwd packages/contracts format:check",
    "simulate:hyperevm-testnet": "bun --cwd packages/contracts simulate:hyperevm-testnet",
    "test": "bun --cwd packages/contracts test && bun --cwd packages/sdk test && bun --cwd apps/web test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
