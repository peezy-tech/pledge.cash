{
  "name": "pledge.cash",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20"
  },
  "workspaces": {
    "packages": [
      "docs",
      "packages/contracts",
      "packages/sdk",
      "apps/*",
      "services/*"
    ],
    "catalog": {
      "@types/node": "^25.6.1",
      "typescript": "5.9.3",
      "viem": "2.55.8"
    }
  },
  "scripts": {
    "build": "bun --cwd packages/contracts build && bun --cwd packages/sdk build && bun --cwd apps/web build",
    "deploy:monad-testnet": "bun --cwd packages/contracts deploy:monad-testnet",
    "deploy:testnets": "bun --cwd packages/contracts deploy:testnets",
    "docs:build": "bun --cwd docs build",
    "docs:check": "bun --cwd docs check:types",
    "docs:dev": "bun --cwd docs dev",
    "format": "bun --cwd packages/contracts format",
    "format:check": "bun --cwd packages/contracts format:check",
    "scenario:local-seed:dry-run": "bun --cwd packages/contracts scenario:local-seed:dry-run",
    "scenario:local-seed:local": "bun --cwd packages/contracts scenario:local-seed:local",
    "scenario:boardroom:dry-run": "bun --cwd packages/contracts scenario:boardroom:dry-run",
    "scenario:boardroom:local": "bun --cwd packages/contracts scenario:boardroom:local",
    "scenario:project-token:dry-run": "bun --cwd packages/contracts scenario:project-token:dry-run",
    "scenario:project-token:local": "bun --cwd packages/contracts scenario:project-token:local",
    "sentinel:dev": "bun --cwd services/sentinel dev",
    "sentinel:integration:anvil": "bun --cwd services/sentinel integration:anvil",
    "sentinel:test": "bun --cwd services/sentinel test",
    "simulate:monad-testnet": "bun --cwd packages/contracts simulate:monad-testnet",
    "simulate:testnets": "bun --cwd packages/contracts simulate:testnets",
    "test:sepolia-fork:deployment": "bun --cwd packages/contracts test:sepolia-fork:deployment",
    "test": "bun --cwd packages/contracts test && bun --cwd packages/sdk test && bun --cwd apps/web test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
