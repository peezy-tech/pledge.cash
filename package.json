{
  "name": "pledge.cash",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20"
  },
  "workspaces": {
    "packages": [
      "docs",
      "packages/contracts",
      "packages/sdk",
      "apps/*",
      "services/*"
    ],
    "catalog": {
      "@types/node": "^25.6.1",
      "typescript": "5.9.3",
      "viem": "2.55.8"
    }
  },
  "scripts": {
    "build": "bun --cwd packages/contracts build && bun --cwd packages/sdk build && bun --cwd apps/web build",
    "deploy:network": "bun --cwd packages/contracts deploy:network",
    "deploy:sepolia": "bun --cwd packages/contracts deploy:sepolia",
    "deploy:base-sepolia": "bun --cwd packages/contracts deploy:base-sepolia",
    "docs:build": "bun --cwd docs build",
    "docs:check": "bun --cwd docs check:types",
    "docs:dev": "bun --cwd docs dev",
    "format": "bun --cwd packages/contracts format",
    "format:check": "bun --cwd packages/contracts format:check",
    "sentinel:dev": "bun --cwd services/sentinel dev",
    "sentinel:integration:anvil": "bun --cwd services/sentinel integration:anvil",
    "sentinel:test": "bun --cwd services/sentinel test",
    "simulate:network": "bun --cwd packages/contracts simulate:network",
    "simulate:sepolia": "bun --cwd packages/contracts simulate:sepolia",
    "simulate:base-sepolia": "bun --cwd packages/contracts simulate:base-sepolia",
    "test:sepolia-fork:deployment": "bun --cwd packages/contracts test:sepolia-fork:deployment",
    "test:base-sepolia-fork:deployment": "bun --cwd packages/contracts test:base-sepolia-fork:deployment",
    "test:testnet-forks:deployment": "bun --cwd packages/contracts test:testnet-forks:deployment",
    "validate:networks": "bun --cwd packages/contracts validate:networks",
    "test": "bun --cwd packages/contracts test && bun --cwd packages/sdk test && bun --cwd apps/web test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
